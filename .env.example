# ─── 데이터베이스 ───────────────────────────────────────────────────
DATABASE_URL=postgresql://pickandgo_admin:dev_password_123@localhost:5432/pickandgo_dev

# ─── 지도 / 장소 API ────────────────────────────────────────────────
GMAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY        # Google Maps / Places API 키
KAKAO_REST_KEY=YOUR_KAKAO_REST_API_KEY        # Kakao 로컬 API REST 키

# ─── 항공 예약 (Duffel) ─────────────────────────────────────────────
DUFFEL_API_KEY=duffel_test_xxxxx              # Duffel 발급 API 토큰
MOCK_FLIGHT=true                               # true=Mock 사용, false=Duffel 실 API

# ─── 숙소 예약 (LiteAPI) ────────────────────────────────────────────
LITEAPI_KEY=sand_xxxxx                        # LiteAPI Sandbox 키
MOCK_HOTEL=true                                # true=Mock 사용, false=LiteAPI 실 API

# ─── 이메일 알림 (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxx                       # Resend API 키
RESEND_FROM_EMAIL=Pick&Go <onboarding@resend.dev>  # 발신자 주소 (Sandbox: onboarding@resend.dev)

# ─── 예약 검증 Mock ─────────────────────────────────────────────────
MOCK_VERIFY=false                              # true=검증 단계 건너뜀 (개발용)

# ─── Mock 성공률 조정 (선택) ─────────────────────────────────────────
MOCK_FLIGHT_SUCCESS_RATE=0.95                 # 0.0~1.0 (기본 0.95)
MOCK_HOTEL_SUCCESS_RATE=0.95                  # 0.0~1.0 (기본 0.95)

# ─── 예약 타임아웃 (선택) ────────────────────────────────────────────
BOOKING_TIMEOUT_SEC=10.0                      # 외부 API 응답 대기 최대 초
